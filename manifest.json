{
  "manifest_version": 3,
  "name": "Stream Community Player",
  "short_name": "SC Player",
  "version": "1.0.2",
  "description": "Player stile Netflix per StreamingCommunity e VixCloud: fullscreen automatico, autoplay con audio, UI moderna, risoluzioni reali.",
  "author": "Kittystyle850",
  "homepage_url": "https://github.com/Kittystyle850/stream-community-player",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "contentSettings"
  ],
  "host_permissions": [
    "*://vixcloud.co/*",
    "*://*.vixcloud.co/*",
    "*://*.streamingcommunity.computer/*",
    "*://*.streamingcommunityz.pictures/*",
    "*://*.streamingcommunityz.website/*",
    "*://*.streamingunity.top/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Stream Community Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://vixcloud.co/*",
        "*://*.vixcloud.co/*",
        "*://*.streamingcommunity.computer/*",
        "*://*.streamingcommunityz.pictures/*",
        "*://*.streamingcommunityz.website/*",
        "*://*.streamingunity.top/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stream-community-player@kittystyle850.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "minimum_chrome_version": "121"
}
